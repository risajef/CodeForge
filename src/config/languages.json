{
  "supported_languages": {
    "eiffel": {
      "name": "Eiffel",
      "executor_class": "EiffelExecutor",
      "file_extension": ".e",
      "description": "Eiffel programming language",
      "enabled": true
    }
  },
  "default_language": "eiffel",
  "timeout_limits": {
    "min": 5,
    "max": 300,
    "default": 30
  },
  "compiler_settings": {
    "max_file_size": "10MB",
    "temp_dir": "/tmp/code_execution"
  }
}
